{
  "name": "backend-acervo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Downloader de acervo do AVA para uso pessoal. Lista o catalogo como o aluno ve, baixa conteudos no mesmo formato do PWA APP-Estudante.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n servidor,web -c blue,green \"npm:servidor\" \"npm:dev:web\"",
    "dev:watch": "concurrently -k -n servidor,web -c blue,green \"npm:dev:servidor\" \"npm:dev:web\"",
    "dev:servidor": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env --watch-path=servidor --watch-path=nucleo-conteudo --watch-path=adaptadores servidor/index.js",
    "dev:web": "vite",
    "build": "vite build",
    "servidor": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env servidor/index.js",
    "baixar": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env scripts/baixar.js",
    "verificar-updates": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env scripts/verificar-updates.mjs",
    "exportar": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env scripts/exportar-r2.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "express": "^5.1.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "vite": "^8.0.0"
  }
}
