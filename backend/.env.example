# Configuracao do downloader de acervo — MODELO.
#
# Copie este arquivo para `.env` e ajuste. O `.env` NAO vai para o git (esta no
# .gitignore) porque pode conter credenciais. Carregado automaticamente pelos
# scripts npm (node --env-file-if-exists=.env, nativo do Node 24+).
#
#   cp .env.example .env      # (ou copie a mao no Windows)

# --- Backend do AVA (API: login, catalogo, paginas) --------------------------
# O QUE VOCE PROVAVELMENTE VEIO AQUI TROCAR. Sem esta linha, o padrao e homologa.
#   homologa (padrao): https://backhomologa.educandus.com.br
#   producao:          https://back.educandus.com.br
ACERVO_BASE_BACKEND=https://backhomologa.educandus.com.br

# --- Credenciais (opcional) --------------------------------------------------
# Se preenchidas, `npm run baixar` e `npm run verificar-updates` nao precisam de
# --usuario/--senha. Deixe em branco para passar sempre na linha de comando.
# ACERVO_USUARIO=
# ACERVO_SENHA=

# --- Cloudflare R2 (escrever o acervo direto no bucket) ----------------------
# Preenchidas TODAS as quatro (ACCOUNT_ID, ACCESS_KEY_ID, SECRET, BUCKET), o
# download sobe o zip + manifesto ao R2 e a aba Acervo passa a ler do bucket (o
# acervo online vira a fonte). Em branco, o downloader grava em disco (fallback),
# como antes — nada quebra sem estas.
# A escrita e server-side (este processo Node), NAO passa por CORS. O CORS do
# bucket segue so com GET, para o PWA (navegador) LER.
# Crie um API token R2 com permissao de ESCRITA no painel (R2 -> Manage API Tokens).
# ATENCAO: a Secret da poder de apagar/sobrescrever o bucket — trate como segredo.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=acervo-educandus
# R2_PREFIXO=offline-conteudos     # pasta no bucket; precisa casar com o VITE_PRE_CARGA_URL do PWA

# --- Origens dos arquivos do publicador (raramente mudam) --------------------
# Nao seguem homologa/producao — sao hosts fixos de conteudo. So mexa se souber.
# ACERVO_BASE_CONTEUDOS=http://conteudos.educandus.com.br
# ACERVO_BASE_AULASPRE=http://aulaspre.educandus.com.br

# --- Acervo local e semente --------------------------------------------------
# ACERVO_RAIZ=./acervo                 # onde os zips sao gravados
# ACERVO_VERSAO_SEMENTE=1              # versao da pre-carga no manifesto
# PORT=5174                            # porta do servidor web

# --- Ajustes de rede/retry (avancado) ----------------------------------------
# ACERVO_TIMEOUT_MS=20000              # timeout da API
# ACERVO_TIMEOUT_ARQUIVO_MS=120000     # timeout de download de arquivo
# ACERVO_TENTATIVAS=3                  # retries de arquivo
# ACERVO_TENTATIVAS_CONTEUDO=2         # retries por conteudo
# ACERVO_ATRASO_RETRY_MS=1000          # espera entre retries
