{
  "name": "acervo-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Backend do downloader de acervo do AVA: servidor Express (login, catalogo, fila de download, acervo) + CLI de download/exportacao. Baixa conteudos no mesmo formato de pacote do PWA APP-Estudante.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env --watch-path=servidor --watch-path=nucleo-conteudo --watch-path=adaptadores servidor/index.js",
    "start": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env servidor/index.js",
    "baixar": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env scripts/baixar.js",
    "verificar-updates": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env scripts/verificar-updates.mjs",
    "exportar": "cross-env NODE_EXTRA_CA_CERTS=certificados/gsgccr6-alphassl-2025.pem node --env-file-if-exists=.env scripts/exportar-r2.mjs",
    "test": "node servidor/testar-autorizacao.mjs && node servidor/testar-indisponiveis.mjs && node servidor/testar-disciplinas.mjs && node servidor/testar-verificacoes.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "express": "^5.1.0",
    "fflate": "^0.8.3"
  },
  "devDependencies": {
    "cross-env": "^7.0.3"
  }
}
